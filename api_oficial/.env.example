# API Oficial - WhatsApp Meta Business API
NODE_ENV=production
PORT=6005

# URL Publica da API
API_URL=https://SEU_DOMINIO_API_OFICIAL

# Banco de Dados PostgreSQL
DATABASE_LINK=postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO

# Token de Administracao
TOKEN_ADMIN=GERAR_TOKEN_SEGURO_AQUI

# URL do Backend Principal (WebSocket)
URL_BACKEND_MULT100=https://SEU_DOMINIO_BACKEND

# Redis
REDIS_URI=redis://:SUA_SENHA_REDIS@127.0.0.1:5005

# RabbitMQ (opcional)
RABBITMQ_ENABLED_GLOBAL=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
